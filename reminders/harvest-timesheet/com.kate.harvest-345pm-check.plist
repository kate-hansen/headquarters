<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kate.harvest-345pm-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/katehansen/.config/harvest-timesheet/check.sh</string>
    </array>

    <!-- Fire on login/agent-load, then re-check hourly. The script no-ops before 3:45pm ET
         and once the local stamp == today, so it reminds at most once per ET day. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/Users/katehansen/.config/harvest-timesheet/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/katehansen/.config/harvest-timesheet/launchd.err.log</string>
</dict>
</plist>
